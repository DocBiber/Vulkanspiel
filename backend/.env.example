# Vorlage fuer backend/.env
#
# Kopiere diese Datei nach backend/.env und traege deinen Schluessel ein.
#
#   Copy-Item backend/.env.example backend/.env
#
# Die Datei backend/.env wird von Git ignoriert und kommt nie ins Repository.
# Den Schluessel niemals in einen Chat schreiben.

# API-Schluessel aus Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=

# Name des Modells. Pruefe in Google AI Studio, welches Modell verfuegbar ist.
GEMINI_MODEL=gemini-2.5-flash

# Port, auf dem der Dienst lokal lauscht.
PORT=8080

# Ursprung des Spiels, der den Dienst aufrufen darf.
# Bei GitHub Pages: https://DEIN-NUTZERNAME.github.io
# Bei einer eigenen Domain: https://DEINE-DOMAIN.de
# Lokal mit einer Datei: file://  (Achtung: Browser blockieren das oft)
FRONTEND_ORIGIN=http://localhost:5173
